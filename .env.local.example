# Neon — create a free Postgres project at https://neon.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Razorpay — use test keys while testing, then replace with the client's live keys.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=use_a_long_random_value_here

# Resend — verify the client's domain before using it as the FROM address.
RESEND_API_KEY=re_your_key_here
ORDER_FROM_EMAIL=INZZOUT Orders <orders@your-domain.com>
ORDER_NOTIFICATION_EMAIL=client-orders@example.com
